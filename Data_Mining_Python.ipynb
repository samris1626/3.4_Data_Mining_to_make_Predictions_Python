## STEP 5: COMPARE PREDICTIONS
df_clean['Pred_Logistic'] = logistic_model.predict(X)
df_clean['Pred_RF'] = rf_classifier.predict(X)
df_clean['Pred_SVM'] = svm_classifier.predict(X)

log_correct = sum(df_clean['price_category'] == df_clean['Pred_Logistic'])
rf_correct = sum(df_clean['price_category'] == df_clean['Pred_RF'])
svm_correct = sum(df_clean['price_category'] == df_clean['Pred_SVM'])

log_incorrect = len(df_clean) - log_correct
rf_incorrect = len(df_clean) - rf_correct
svm_incorrect = len(df_clean) - svm_incorrect if 'svm_incorrect' in locals() else len(df_clean) - svm_correct

correct_counts = [log_correct, rf_correct, svm_correct]
incorrect_counts = [log_incorrect, rf_incorrect, svm_incorrect]

barWidth = 0.35
r1 = np.arange(len(correct_counts))
r2 = [x + barWidth for x in r1]

plt.figure(figsize=(10, 6))
plt.bar(r1, correct_counts, color='#2ca02c', width=barWidth, edgecolor='grey', label='Correct')
plt.bar(r2, incorrect_counts, color='#d62728', width=barWidth, edgecolor='grey', label='Incorrect')

plt.xlabel('Models', fontweight='bold')
plt.xticks([r + barWidth / 2 for r in range(len(correct_counts))], models)
plt.ylabel('Count')
plt.title('Model Prediction Comparison: Correct vs. Incorrect (Full Dataset)')
plt.legend()
plt.show()
