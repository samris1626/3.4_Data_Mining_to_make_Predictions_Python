svm_classifier = SVC(random_state=42)

logistic_model.fit(X_train, y_train)
rf_classifier.fit(X_train, y_train)
svm_classifier.fit(X_train, y_train)

train_acc_log = accuracy_score(y_train, logistic_model.predict(X_train))
train_acc_rf = accuracy_score(y_train, rf_classifier.predict(X_train))
train_acc_svm = accuracy_score(y_train, svm_classifier.predict(X_train))

display(Markdown(f"### {student_id} - {todays_date}"))
display(Markdown(f"**Logistic Regression Training Accuracy:** {train_acc_log:.4f}"))
display(Markdown(f"**Random Forest Training Accuracy:** {train_acc_rf:.4f}"))
display(Markdown(f"**SVM Training Accuracy:** {train_acc_svm:.4f}"))


## STEP 4: METRICS, MATRICES & VISUALIZATION
y_pred_log = logistic_model.predict(X_test)
y_pred_rf = rf_classifier.predict(X_test)
y_pred_svm = svm_classifier.predict(X_test)

